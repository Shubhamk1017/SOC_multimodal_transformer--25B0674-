{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run InfoNCE Sanity Tests",
      "type": "shell",
      "command": "python3 task5/test_loss.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Run Toy Alignment",
      "type": "shell",
      "command": "python3 task5/toy_alignment.py",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Generate Task 5 PDF Derivations",
      "type": "shell",
      "command": "python3 task5/generate_derivation_pdf.py",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Build All Task 6 Deliverables",
      "type": "shell",
      "command": "python3 task6/make_artifacts.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Run Text-to-Image Search",
      "type": "shell",
      "command": "python3 task6/text_to_image_search.py",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
